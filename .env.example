# Copie para .env e ajuste conforme necessário (todos têm padrões de dev).
# O JWT_SECRET deve ser idêntico em todos os serviços.
JWT_SECRET=nomad-dev-secret-change-me
JWT_EXPIRES_IN=7d

# Portas dos microserviços
GATEWAY_PORT=4000
AUTH_PORT=4001
POSTS_PORT=4002
FILES_PORT=4003

# URLs usadas pelo gateway para encontrar os serviços
AUTH_URL=http://localhost:4001
POSTS_URL=http://localhost:4002
FILES_URL=http://localhost:4003

# Frontend (Vite) → gateway
GATEWAY_URL=http://localhost:4000

# Limite de upload (MB)
MAX_UPLOAD_MB=50
